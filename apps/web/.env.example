# Base URL of the FastAPI backend, WITHOUT the /api/v1 suffix (the app adds it).
# Dev: separate localhost port. Prod: https://api.<project-subdomain>.<yourdomain>
NEXT_PUBLIC_API_URL=http://localhost:8000

# YouTube video shown on /demo-video: a video ID or a YouTube link. Empty shows "coming soon".
# Baked in at build time, like the API URL.
NEXT_PUBLIC_DEMO_VIDEO_ID=
